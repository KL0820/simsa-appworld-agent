# Copy to .env and fill in.
# AppWorld checkout containing data/ and rpc/server.py.
APPWORLD_ROOT=/absolute/path/to/appworld

# Choose ONE authentication route. Never commit a populated .env.
# A. Gemini Developer API key:
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
# B. Vertex AI with Application Default Credentials (ADC):
# Omit GOOGLE_API_KEY, set GOOGLE_GENAI_USE_VERTEXAI=true and uncomment these.
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# Authenticate with your organization's approved ADC setup.
MODEL_NAME=gemini-2.5-flash

# AppWorld zerorpc server.
RPC_URL=tcp://127.0.0.1:4244

# Default task to run
TASK_ID=6104387_3
EXPERIMENT_NAME=local_dev
